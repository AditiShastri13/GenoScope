# Genoscope Environment Configuration

# Set environment (development, production)
ENVIRONMENT=development

# API settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_LOG_LEVEL=info

# Security
API_KEY_HEADER=X-API-Key
ADMIN_API_KEY=change_this_in_production

# CORS allowed origins for production
# Comma-separated list of domains
CORS_ORIGINS=https://genoscope.example.com,https://app.genoscope.example.com

# Database settings (for future use)
# DATABASE_URL=postgresql://user:password@localhost/genoscope

# Model paths (relative to application root)
MODEL_DIR=trained_models

# Maximum allowed file size for uploads (in bytes)
MAX_UPLOAD_SIZE=5242880  # 5MB